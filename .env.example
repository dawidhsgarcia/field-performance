# Configuração Firebase (Web)
# Copie este arquivo para .env.local e preencha com os valores do projeto.
# As chaves de configuração Web do Firebase são públicas por natureza (não são segredos),
# mas ficam em arquivo local ignorado pelo git para centralizar a configuração via ambiente.
#
# O aplicativo só inicializa o Firebase se VITE_FIREBASE_API_KEY e
# VITE_FIREBASE_PROJECT_ID estiverem preenchidas (ver src/lib/env.ts).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
