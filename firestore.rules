rules_version = '2';

// Regras de segurança do Field Performance (Firebase Firestore) — PRODUÇÃO
// Projeto: produtividade-regionalnorte
// Aplicar via Firebase CLI:
//   firebase deploy --only firestore:rules
//
// Pré-requisitos já atendidos:
// 1) Backup diário autenticado — .github/scripts/backup-firestore.mjs usa
//    signInWithPassword (FIREBASE_BACKUP_EMAIL/PASSWORD) e lê com Bearer token.
//    A leitura de `produtividade/estado` exige apenas isSignedIn(), então a
//    conta de backup (davidsgarcia.dev@gmail.com) funciona.
// 2) `usuarios` carregada só após o login — auth.store.init() inicia
//    loadUsuarios apenas quando existe firebaseUser (ver src/stores/auth.store.ts).
// 3) Admin bootstrap — a app trata ADMIN_BOOTSTRAP_EMAIL como admin sem
//    documento em `usuarios` (src/lib/constants.ts), MAS as regras exigem o
//    documento para escrita. O doc usuarios/{uid} do admin foi criado via seed.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function perfilDoUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.perfil;
    }

    function isAdmin() {
      return isSignedIn() && perfilDoUsuario() == 'admin';
    }

    function isGestorOuAdmin() {
      return isSignedIn() && (perfilDoUsuario() == 'gestor' || perfilDoUsuario() == 'admin');
    }

    // Documento de estado (produtividade/estado)
    match /produtividade/{doc} {
      allow read: if isSignedIn();
      allow write: if isGestorOuAdmin();
    }

    // Usuários e permissões — leitura autenticada, escrita só admin
    match /usuarios/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
