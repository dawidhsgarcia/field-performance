# Ambiente de HOMOLOGAÇÃO — projeto Firebase separado (NÃO usar o projeto de produção)
# Uso: npm run dev -- --mode homologation
# O Vite carrega .env.homologation e .env.homologation.local (este último não é commitado).
# Preencha com as credenciais do projeto de homologação.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Seed/reset (scripts Node) — não é lido pelo Vite; configure no ambiente do terminal:
#   FIREBASE_HOMOLOG_SERVICE_ACCOUNT=C:/caminho/para/homolog-service-account.json
#   node scripts/seed-homolog.mjs --source ../backups/estado-2026-08-14.json
#   node scripts/reset-homolog.mjs
